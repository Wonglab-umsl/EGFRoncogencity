#! /bin/bash
#SBATCH --account=wongch-lab
#SBATCH --partition=requeue
#SBATCH --job-name=egfr-rama-histogram
#SBATCH --time=1-00:00:00
##SBATCH --mail-type=begin,end,fail,requeue
#SBATCH --export=all
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=131072
#SBATCH --array=1
#make both plots: the one covering residues 718-725 and the one covering the DFG motif (854-857)
#~/.conda/envs/mdtraj/bin/python
mut_type=`echo "benign1 benign2 pathogenic1 pathogenic2 pathogenic3 pathogenic4" | awk -v i=$SLURM_ARRAY_TASK_ID '{print $i}'`
module load miniconda3
conda activate mdtraj
python3  k-e_salt-bridge-time2.py $mut_type 3 745 762 10
#python3  k-e_salt-bridge-time.py $mut_type 3 708 709 10
#~/.conda/envs/mdtraj/bin/python ./egfr-rama-histogram.py 854 857 1

