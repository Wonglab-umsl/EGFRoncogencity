*
bomblev -1
set toppar = ~/toppar_c36_jul20
open unit 1 read formatted name @toppar/top_all36_prot.rtf
read rtf card unit 1
close unit 1
open unit 1 read formatted name @toppar/par_all36m_prot.prm
read para card unit 1
close unit 1
open unit 1 read formatted name @name.psf
read psf card unit 1
close unit 1
open unit 1 read formatted name data/@name.cor
read coor card unit 1
close unit 1
!energy
!these are the residues present in the original pdb



!define an atom selection called "known" that contains the residues for which 
!coordinates were not model built -- these will have restraints on them 
!the idea is that we impose restraints only on those atoms whose coordinates originally came from the PDB file
!other atoms whose coordinates came from MODELLER, etc., will have their energies minimized first
if name .eq. egfr-wt-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 750:985 end
else if name .eq. egfr-t747t751p-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 752:985 end
else if name .eq. egfr-t751i759n-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 760:985 end
else if name .eq. egfr-del747lre-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 750:985 end
else if name .eq. egfr-wt-inactive-charmm then
	define known select resid 701:871 .or. resid 875:983 end
else if name .eq. egfr-dele746a750-active-charmm then
	define known select resid 696:720 .or. resid 723:745 .or. resid 751:985 end
else if name .eq. egfr-t790m-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 750:789 .or. resid 791:985 end
else if name .eq. egfr-l858r-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 750:857 .or. resid 859:985 end
else if name .eq. egfr-t790m-active-charmm then
	define known select resid 696:720 .or. resid 723:746 .or. resid 750:789 .or. resid 791:857 .or. resid 859:985 end
else
	echo "unknown name"
	stop
endif
define known select known .and. .not. type h* show end


#we had issues with chirality, so this ensures that everything has proper chirality

!use 1-based residue numbers here
set res = 1
label resloop
        calc r = @res + 695
        define x select type CA .and. resid @r:@r end
        if ?selresn .ne. GLY then
                !it's a chiral amino acid
                !introduce a dihedral restraint to force this dihedral to be positive
                cons dihe prot @r n prot @r ca prot @r c prot @r ha force 1000000.0 min 90.0 width 90.0
        endif
	if ?selresn .eq. ILE then
		!chiral side chain
		cons dihe prot @r ca prot @r cg1 prot @r cb prot @r hb force 1000000.0 min -90.0 width 90.0
	endif
	if ?selresn .eq. THR then
		cons dihe prot @r ca prot @r og1 prot @r cb prot @r hb force 1000000.0 min -90.0 width 90.0
	endif

incr res by 1
if res .le. 289 then goto resloop

if name .eq. egfr-h773insnph-active-charmm then
	cons dihe prot 773b cb prot 773b n prot 773b ca prot 773b ha force 1000000.0 min -90.0 width 90.0
endif

!do a "pre-minimization" of isoleucine and threonine chiral hydrogens to try to ensure they end up on the correct side of the carbon
cons fix select .not. ( ( resname ILE .and. type HB ) .or. ( resname THR .and. type HB ) .or. ( resname PRO .and. type HA) ) end
mini sd nstep 100
cons fix select none end

open unit 1 write format name data/@name-premin.cor
write coor card unit 1
close unit 1
!stop


!Recommended setup for molecular dynamics simulations with
  !the GBMV II algorithm:

  UPDATE atom CDIE eps 1 cutnb 21 ctofnb 18 ctonnb 16 switch vswitch

  GBMV EPSILON 80 BUFR 0.2 MEM 20 CUTA 20 ALFRQ 1 -
       GEOM BETA -12 P1 0.45 P2 1.25 P3 0.65 P6 8.0 -
       CORR 1 SHIFT -0.1 SLOPE 0.9 WTYP 1 NPHI 5 -
       FAST 1 SGBFRQ 4 SXD 0.3


coor copy comp
set i = 1
label loopstart
        calc k = 10 ** (5 - @i)
        cons harm abso force @k mass comp select known end
        mini sd nstep 100
        mini abnr nstep 100
        cons harm clear
incr i by 1
if i .le. 5 goto loopstart
cons harm clear

open unit 1 write formatted name data/@name-min.cor
write coor card unit 1
close unit 1
open unit 1 write formatted name data/@name-min.pdb
write coor pdb unit 1
close unit 1
stop
