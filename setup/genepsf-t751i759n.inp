*
bomblev -1
set toppar = ~/toppar_c36_jul20
open unit 1 read formatted name @toppar/top_all36_prot.rtf
read rtf card unit 1
close unit 1
open unit 1 read formatted name @toppar/par_all36_prot.prm
read para card unit 1
close unit 1
open unit 1 read formatted name egfr-t751i759n.seq
read sequ card unit 1
close unit 1
generate prot warn angle dihedral
open unit 1 read formatted name egfr-t751i759n-active-start.pdb
read coor pdb unit 1
close unit 1

set res = 1
label loop
	calc newres = @res + 695
	!8 residues were deleted
	if newres .gt. 751 then
		calc newres = @newres + 8
	endif
	rename resid @newres select resid @res:@res end
incr res by 1
if res .le. 290 goto loop
ic generate
ic param
ic build
hbuild select type h* end
hbuild select type h* end
long
ioformat extended
open unit 1 write formatted name egfr-t751i759n-active-charmm.psf
write psf card unit 1
close unit 1
open unit 1 write formatted name data/egfr-t751i759n-active-charmm.cor
write coor card unit 1
close unit 1
stop
