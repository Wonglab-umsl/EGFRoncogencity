*
bomblev -1
set toppar = ~/toppar_c36_jul20
open unit 1 read formatted name @toppar/top_all36_prot.rtf
read rtf card unit 1
close unit 1
open unit 1 read formatted name @toppar/par_all36_prot.prm
read para card unit 1
close unit 1
open unit 1 read formatted name egfr-ins770npg771.seq
read sequ card unit 1
close unit 1
generate prot warn angle dihedral

set res = 1
label loop
	calc newres = @res + 695
	!relabel inserted residues as 770A, 770B, 770C, and then 771 onwards 
	if @res .eq. 76 then
		set newres = 770A
	endif
	if @res .eq. 77 then
		set newres = 770B
	endif
	if @res .eq. 78 then 
		set newres = 770C
	endif
	if @res .ge. 79 then !771 and beyond
		calc newres = @newres - 3
	endif
	rename resid @newres select resid @res:@res end
incr res by 1
if res .le. 293 goto loop
long
ioformat extended
open unit 1 write formatted name egfr-ins770npg771-active-charmm.psf
write psf card unit 1
close unit 1
stop
