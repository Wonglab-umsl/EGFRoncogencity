*
bomblev -1
set toppar = ~/toppar_c36_jul20
open unit 1 read formatted name @toppar/top_all36_prot.rtf
read rtf card unit 1
close unit 1
open unit 1 read formatted name @toppar/par_all36_prot.prm
read para card unit 1
close unit 1
open unit 1 read formatted name egfr-dell747s752p753s.seq
read sequ card unit 1
close unit 1
generate prot warn angle dihedral

set res = 1
label loop
	calc newres = @res + 695
	if newres .gt. 750 then
		calc newres = @newres + 2
	else
		if  newres .gt. 746 then
			calc newres = @newres + 1 
		endif
	endif
	rename resid @newres select resid @res:@res end
incr res by 1
if res .le. 290 goto loop
long
ioformat extended
open unit 1 write formatted name egfr-dell747s752p753s-active-charmm.psf
write psf card unit 1
close unit 1
stop
