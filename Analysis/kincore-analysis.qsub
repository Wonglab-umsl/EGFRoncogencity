#! /bin/bash
#SBATCH --partition=general
#SBATCH --account=wongch-lab
#SBATCH --job-name=egfr-kincore-analysis
#SBATCH --time=0-10:00:00
##SBATCH --mail-type=begin,end,fail,requeue
#SBATCH --export=all
#SBATCH --out=slurm-%A_%a.out
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=34-99

task=$SLURM_ARRAY_TASK_ID
#export name=`echo "egfr-wt-active-charmm egfr-t747t751p-active-charmm egfr-t751i759n-active-charmm" | \
#	 awk -v i=$task '{print $i}'`
export name=`awk -v i=$task '($1==i) {print $2}' new-list`
export id=`awk -v i=$task '($1==i) {print $3}' new-list`
export PATH=/home/voavtv/.conda/envs/kincore-standalone2/bin:$PATH

module load miniconda3
./kincore-analysis $name $id 100
